NODE_ENV=development
PORT=8000
PUBLIC_URL=http://localhost:8000
DATA_DIR=data
# Optional locally; required for durable free-container hosting.
DATABASE_URL=
DB_SCHEMA=vellum_accounts
ENGINE_DB_SCHEMA=vellum_engine
# Only this verified email gets the initial administrator role.
BOOTSTRAP_ADMIN=owner@example.com
# Production requires HTTPS and mail configuration. Never commit credentials.
SMTP_URL=
BREVO_API_KEY=
MAIL_FROM=
# PYTHON_BIN=
